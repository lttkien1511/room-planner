# Where the API stores projects. ./data = local disk of this host.
# After the OMV share is mounted run ./use-omv.sh, which switches this to /mnt/omv/room-planner.
DATA_DIR=./data
APP_UID=1000
APP_GID=1000
# Host port for the web container. Prod uses the default 5080; the dev checkout overrides this.
WEB_PORT=5080
